# ===== 通义千问 / DashScope =====
# LLM 与 Embedding 均通过 OpenAI 兼容端点调用
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== Redis（可选：仅作会话历史热缓存，不可用时回源 MySQL）=====
# 该口令由 docker-compose 启动时注入 redis（--requirepass），不再写死在 redis.conf；
# 留空则不启用 Redis 鉴权（本地开发默认留空即可）。
Redis_password=
# Docker 编排专用：容器内通过服务名访问（docker-compose.yml 已自动设置，本地部署不填）
# REDIS_HOST=redis
# REDIS_PORT=6379

# ===== API 交互文档（可选）=====
# 默认关闭 /docs、/redoc、/openapi.json（避免接口面暴露）；本地演示设 true 即可打开
ENABLE_API_DOCS=false

# ===== 默认账号与登录令牌（可选）=====
# 默认管理员/买家的口令不再写死在代码里：不配置则后端首次启动时生成随机口令并打印到日志；
# 本地演示想用固定口令登录，就在此显式设置（口令至少 6 位）。
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=
DEFAULT_BUYER_USERNAME=customer
DEFAULT_BUYER_PASSWORD=
# 登录令牌有效期（小时）：过期后接口返回 401，需重新登录
TOKEN_TTL_HOURS=168

# ===== 稳定性 / 成本（可选）=====
# 单次 LLM 调用超时（秒）；流式下是两个 chunk 之间的读超时
LLM_TIMEOUT=30
# 请求体上限（字节，默认 12MB；上传文件本身另限 10MB）
MAX_REQUEST_BODY_SIZE=12582912
# 建单幂等窗口（秒）：同账号+订单+分类在该窗口内只落一张单
TICKET_IDEMPOTENCY_WINDOW=300
# 检索前按问题关键词做 doc_category 预过滤（两个入口统一走这里）
AUTO_FILTER=true

# ===== MySQL（必需：订单/工单/用户/会话历史/DST 状态均落库）=====
# Docker 编排时以下四项会被 compose 自动覆盖为容器服务名，无需改动
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=rag_user
MYSQL_PASSWORD=xxxxxxxx
MYSQL_DATABASE=rag_db
# Docker 编排专用：MySQL 容器的 root 口令（首次初始化数据卷时使用，本地部署不需要）
# MYSQL_ROOT_PASSWORD=xxxxxxxx
